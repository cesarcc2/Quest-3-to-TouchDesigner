* text=auto

# Shell scripts must keep LF or bash fails with "\r: command not found"
*.sh text eol=lf

# Unity YAML: diff as text, never auto-merge blindly
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text eol=lf

# Binaries
*.so binary
*.dll binary
*.dylib binary
*.png binary
*.onnx binary
*.apk binary
